# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lavishn_healthcare?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: email notifications for contact form (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_EMAIL=support@lavishn.com

# Optional: seed first admin on startup (only if no admin exists)
ADMIN_EMAIL=admin@lavishn.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
